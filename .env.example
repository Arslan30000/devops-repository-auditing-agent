# Copy to .env and fill in a real key locally. Never commit credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# For Groq: use its key above and OPENAI_MODEL=openai/gpt-oss-20b.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
AUDIT_MAX_CONTEXT_CHARS=14000
AUDIT_MAX_COMPLETION_TOKENS=2048
# Bounded temporary HTTP 429 retries, per request; 0 disables waiting.
AUDIT_MAX_RATE_WAIT_SECONDS=120
AUDIT_MAX_RATE_RETRIES=5
