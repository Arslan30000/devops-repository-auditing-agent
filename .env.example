# Set this in the shell environment before running the agent; never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# For GroqCloud, use its key above, set OPENAI_MODEL=openai/gpt-oss-120b,
# and uncomment the endpoint below. Load this file into the shell environment.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

